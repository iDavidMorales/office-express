{
  "author": "Office Express",
  "description": "Office Express — navegador ligero para Google Workspace (Documentos, Hojas de cálculo, Presentaciones, Drive, Gmail y más) en Windows y macOS.",
  "license": "MIT",
  "main": "main.js",
  "name": "office-express",
  "version": "1.1.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:win:dir": "electron-builder --win dir --x64",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.routicket.officeexpress",
    "productName": "Office Express",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "google-identity-preload.js",
      "renderer/**",
      "web/apps.js",
      "assets/**",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Office Express"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": ["dmg"]
    }
  }
}
